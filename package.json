{
  "name": "neatnotes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "desktop:build": "tsc -b && vite build --mode desktop",
    "desktop": "npm run desktop:build && electron .",
    "desktop:dev": "electron . --dev",
    "desktop:package": "npm run desktop:build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.18",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "idb-keyval": "^6.3.0",
    "katex": "^0.18.11",
    "marked": "^18.2.1",
    "marked-katex-extension": "^5.1.13",
    "modern-screenshot": "^4.7.0",
    "nanoid": "^5.1.16",
    "pdf-lib": "^1.17.1",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "y-codemirror.next": "^0.3.6",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.33"
  },
  "main": "electron/main.cjs",
  "description": "NeatNotes: notes with handwriting, typing and pictures",
  "author": "exhilarating0411",
  "build": {
    "appId": "io.github.exhilarating0411.neatnotes",
    "productName": "NeatNotes",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist-desktop/**",
      "package.json"
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh-TW"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "NeatNotes",
      "artifactName": "NeatNotes-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "exhilarating0411",
        "repo": "inkpad",
        "releaseType": "release"
      }
    ]
  }
}
